---
import { getCollection } from "astro:content";
import Layout from "./Layout.astro";
import Navbar from "../blocks/Navbar/Navbar.astro";
import Footer from "../components/Footer/Footer.astro";
import Drawer from "../components/Drawer/Drawer.astro";

interface Props {
  title?: string;
  description?: string;
  /** The current entry's id, to highlight it in the sidebar nav. */
  currentSlug?: string;
}

const { title, description, currentSlug } = Astro.props;

const entries = (await getCollection("docs")).sort((a, b) => a.data.order - b.data.order);

const navLinkClass = (active: boolean) =>
  [
    "block border-2 px-3 py-2 font-heading text-sm font-semibold",
    active ? "border-ink bg-yellow text-ink" : "border-transparent text-ink hover:bg-ink hover:text-paper",
  ].join(" ");
---

<Layout title={title ? `${title} — Neubrutal Docs` : "Neubrutal Docs"} description={description}>
  <Navbar brand="Neubrutal" links={[{ label: "Home", href: "/" }, { label: "Docs", href: "/docs" }]} ctaLabel="View theme" ctaHref="/" />

  <div class="mx-auto max-w-6xl px-6 py-10 lg:flex lg:items-start lg:gap-10">
    <button
      type="button"
      data-dialog-open="docs-nav"
      class="mb-6 flex w-full items-center justify-between border-2 border-ink bg-paper px-4 py-3 font-heading font-bold shadow-brutal-sm lg:hidden"
    >
      Documentation menu
      <svg viewBox="0 0 16 16" fill="none" class="size-4" stroke="currentColor" stroke-width="2">
        <path d="M2 4h12M2 8h12M2 12h12" stroke-linecap="square" />
      </svg>
    </button>

    <aside class="hidden shrink-0 lg:block lg:w-56">
      <nav class="sticky top-24 flex flex-col gap-1" aria-label="Documentation">
        {entries.map((entry) => <a href={`/docs/${entry.id}`} class={navLinkClass(entry.id === currentSlug)}>{entry.data.title}</a>)}
      </nav>
    </aside>

    <main class="docs-prose min-w-0 flex-1">
      <slot />
    </main>
  </div>

  <Drawer id="docs-nav" title="Documentation" side="left">
    <nav class="flex flex-col gap-1" aria-label="Documentation">
      {
        entries.map((entry) => (
          <a href={`/docs/${entry.id}`} data-dialog-close class={navLinkClass(entry.id === currentSlug)}>
            {entry.data.title}
          </a>
        ))
      }
    </nav>
  </Drawer>

  <Footer brand="Neubrutal" tagline="An Astro + Tailwind theme, built loud on purpose." />
</Layout>

<style>
  .docs-prose :global(h1) {
    font-family: var(--font-display);
    font-size: 2.25rem;
    font-weight: 800;
    text-transform: uppercase;
    line-height: 1.1;
  }

  .docs-prose :global(h2) {
    margin-top: 2.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 3px solid var(--color-ink);
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 700;
  }

  .docs-prose :global(h3) {
    margin-top: 2rem;
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: 700;
  }

  .docs-prose :global(p) {
    margin-top: 1rem;
    line-height: 1.7;
    color: color-mix(in oklch, var(--color-ink) 85%, transparent);
  }

  .docs-prose :global(p.lead) {
    margin-top: 0.5rem;
    font-size: 1.125rem;
    color: color-mix(in oklch, var(--color-ink) 65%, transparent);
  }

  .docs-prose :global(a) {
    color: var(--color-ink);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  .docs-prose :global(ul),
  .docs-prose :global(ol) {
    margin-top: 1rem;
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .docs-prose :global(ul) {
    list-style: square;
  }

  .docs-prose :global(ol) {
    list-style: decimal;
  }

  .docs-prose :global(code) {
    border: 2px solid var(--color-ink);
    background: var(--color-paper);
    padding: 0.1rem 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.85em;
  }

  .docs-prose :global(pre code) {
    border: none;
    background: transparent;
    padding: 0;
  }

  .docs-prose :global(pre) {
    margin-top: 1.25rem;
    border: 3px solid var(--color-ink);
    box-shadow: 8px 8px 0 0 var(--color-ink);
    padding: 1.25rem;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    line-height: 1.6;
  }

  .docs-prose :global(table) {
    margin-top: 1.25rem;
    width: 100%;
    border-collapse: collapse;
    border: 3px solid var(--color-ink);
  }

  .docs-prose :global(th),
  .docs-prose :global(td) {
    border: 2px solid var(--color-ink);
    padding: 0.5rem 0.75rem;
    text-align: left;
    font-size: 0.9rem;
  }

  .docs-prose :global(th) {
    background: var(--color-ink);
    color: var(--color-paper);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
  }

  .docs-prose :global(blockquote) {
    margin-top: 1.25rem;
    border-left: 4px solid var(--color-ink);
    padding-left: 1rem;
    font-style: italic;
  }

  .docs-prose :global(hr) {
    margin: 2.5rem 0;
    border: none;
    border-top: 3px solid var(--color-ink);
  }
</style>
