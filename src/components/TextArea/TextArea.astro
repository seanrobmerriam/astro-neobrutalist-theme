---
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"textarea">, "class"> {
  label: string;
  id: string;
  helpText?: string;
  /** Validation error message. Sets `aria-invalid` and is announced via `role="alert"`. */
  error?: string;
  /** Layout for the `actions` slot, if provided. "outside" (default) renders
   * actions as their own row below the textarea; "inside" shares one
   * bordered box with the textarea, with the actions as a footer. */
  actionsPosition?: "inside" | "outside";
  class?: string;
}

const {
  label,
  id,
  helpText,
  error,
  required,
  actionsPosition = "outside",
  rows = 4,
  class: className,
  ...rest
} = Astro.props;

const hasActions = Astro.slots.has("actions");
const helpId = helpText ? `${id}-help` : undefined;
const errorId = error ? `${id}-error` : undefined;
const describedBy = [helpId, errorId].filter(Boolean).join(" ") || undefined;
---

<label for={id} class="block text-ink">
  <span class="text-sm font-semibold">
    {label}
    {required && <span aria-hidden="true"> *</span>}
    {required && <span class="sr-only"> (required)</span>}
  </span>

  {
    hasActions && actionsPosition === "inside" ? (
      <div class="relative mt-1 overflow-hidden border-2 border-ink shadow-brutal-sm transition-all duration-150 focus-within:-translate-x-0.5 focus-within:-translate-y-0.5 focus-within:shadow-brutal">
        <textarea
          id={id}
          rows={rows}
          required={required}
          aria-invalid={error ? "true" : undefined}
          aria-describedby={describedBy}
          class:list={[
            "w-full resize-none border-0 bg-paper px-3 py-2.5 focus-visible:outline focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-focus-ring",
            className,
          ]}
          {...rest}
        />
        <div class="flex items-center justify-end gap-3 border-t-2 border-ink p-3">
          <slot name="actions" />
        </div>
      </div>
    ) : (
      <textarea
        id={id}
        rows={rows}
        required={required}
        aria-invalid={error ? "true" : undefined}
        aria-describedby={describedBy}
        class:list={[
          "mt-1 w-full resize-none border-2 border-ink bg-paper px-3 py-2.5 shadow-brutal-sm focus:outline-none focus-visible:shadow-brutal focus-visible:-translate-x-0.5 focus-visible:-translate-y-0.5",
          className,
        ]}
        {...rest}
      />
    )
  }

  {
    helpText && !error && (
      <span id={helpId} class="mt-1 block text-xs text-ink/60">
        {helpText}
      </span>
    )
  }

  {
    error && (
      <span
        id={errorId}
        role="alert"
        class="mt-1.5 inline-flex items-center gap-1.5 border-2 border-ink-on-accent bg-pink px-2 py-1 text-xs font-semibold text-ink-on-accent"
      >
        <svg
          aria-hidden="true"
          viewBox="0 0 16 16"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="size-3.5 shrink-0"
        >
          <path d="M8 1.5 1.5 13.5h13L8 1.5Z" />
          <path d="M8 6.25v3" />
          <path d="M8 11.5h.01" stroke-width="2.5" />
        </svg>
        {error}
      </span>
    )
  }

  {
    hasActions && actionsPosition === "outside" && (
      <div class="mt-3 flex items-center justify-end gap-3">
        <slot name="actions" />
      </div>
    )
  }
</label>
