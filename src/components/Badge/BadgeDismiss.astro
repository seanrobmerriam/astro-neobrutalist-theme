---
interface Props {
  label: string;
  class?: string;
}

const { label, class: className } = Astro.props;
---

<span
  class:list={[
    "inline-flex items-center gap-2 border-2 border-ink bg-paper px-3 py-1.5 text-sm/none font-semibold text-ink shadow-brutal-sm",
    className,
  ]}
>
  {label}

  <button
    type="button"
    aria-label={`Remove ${label}`}
    class="flex size-4 items-center justify-center bg-ink text-paper hover:bg-pink focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue"
  >
    <svg aria-hidden="true" viewBox="0 0 16 16" fill="currentColor" class="size-3">
      <path
        d="M5.28 4.22a.75.75 0 0 0-1.06 1.06L6.94 8l-2.72 2.72a.75.75 0 1 0 1.06 1.06L8 9.06l2.72 2.72a.75.75 0 1 0 1.06-1.06L9.06 8l2.72-2.72a.75.75 0 0 0-1.06-1.06L8 6.94 5.28 4.22Z"
      />
    </svg>
  </button>
</span>
