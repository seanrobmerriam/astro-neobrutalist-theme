---
import Button from "../Button/Button.astro";
import List from "../List/List.astro";

interface Props {
  name: string;
  price: string;
  period?: string;
  description?: string;
  features: string[];
  ctaLabel: string;
  ctaHref: string;
  featured?: boolean;
  class?: string;
}

const {
  name,
  price,
  period,
  description,
  features,
  ctaLabel,
  ctaHref,
  featured = false,
  class: className,
} = Astro.props;

const listItems = features.map((text) => ({ text }));
---

<div
  class:list={[
    "relative flex flex-col gap-6 border-[3px] p-8",
    // bg-yellow doesn't invert in dark mode, so "featured" needs the fixed
    // border-ink-on-accent/text-ink-on-accent; the plain bg-paper card
    // inverts correctly with border-ink/text-ink.
    featured
      ? "border-ink-on-accent bg-yellow text-ink-on-accent shadow-brutal-lg"
      : "border-ink bg-paper text-ink shadow-brutal",
    className,
  ]}
>
  {
    featured && (
      <span class="absolute -top-3 right-6 border-2 border-ink bg-ink px-3 py-1 font-mono text-xs font-bold uppercase tracking-wide text-paper">
        Most popular
      </span>
    )
  }

  <div>
    <h3 class="font-heading text-lg font-bold uppercase tracking-wide">{name}</h3>
    {
      description && (
        <p class:list={["mt-1 text-sm", featured ? "text-ink-on-accent/70" : "text-ink/70"]}>{description}</p>
      )
    }
  </div>

  <p class="font-display text-5xl font-extrabold">
    {price}
    {
      period && (
        <span class:list={["font-heading text-base font-semibold", featured ? "text-ink-on-accent/60" : "text-ink/60"]}>
          {" "}
          {period}
        </span>
      )
    }
  </p>

  <List variant="check" items={listItems} class="flex-1" />

  <Button href={ctaHref} variant={featured ? "primary" : "outline"} class="w-full justify-center">
    {ctaLabel}
  </Button>
</div>
