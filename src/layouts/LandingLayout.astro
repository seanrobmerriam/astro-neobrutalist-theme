---
import BaseLayout from "./Layout.astro";
import Navbar from "../blocks/Navbar/Navbar.astro";
import Footer from "../components/Footer/Footer.astro";
import ToastViewport from "../components/Toast/ToastViewport.astro";
import { site } from "../config/site";

interface NavLink {
  label: string;
  href: string;
}

interface FooterGroup {
  heading: string;
  links: { label: string; href: string }[];
}

interface Props {
  title?: string;
  description?: string;
  navBrand?: string;
  navLinks?: NavLink[];
  navCtaLabel?: string;
  navCtaHref?: string;
  footerBrand?: string;
  footerTagline?: string;
  footerGroups?: FooterGroup[];
}

const {
  title,
  description,
  navBrand = site.name,
  navLinks = site.nav,
  navCtaLabel = site.cta.label,
  navCtaHref = site.cta.href,
  footerBrand = site.name,
  footerTagline = site.tagline,
  footerGroups = [],
} = Astro.props;
---

<BaseLayout title={title} description={description}>
  <Navbar brand={navBrand} links={navLinks} ctaLabel={navCtaLabel} ctaHref={navCtaHref} />

  <main id="main" data-pagefind-body>
    <slot />
  </main>

  <Footer brand={footerBrand} tagline={footerTagline} groups={footerGroups}>
    <slot name="footer-extra">
      <div class="flex gap-4 font-mono text-xs text-ink/60">
        <a href="/privacy" class="hover:underline hover:decoration-2 hover:underline-offset-4">Privacy</a>
        <a href="/terms" class="hover:underline hover:decoration-2 hover:underline-offset-4">Terms</a>
      </div>
    </slot>
  </Footer>

  <ToastViewport />

  <!-- Modals, drawers, and other overlay-only components live here so they render once, outside <main>. -->
  <slot name="overlays" />
</BaseLayout>
