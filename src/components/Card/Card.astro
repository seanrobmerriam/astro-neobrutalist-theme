---
import type { HTMLAttributes } from "astro/types";

type Accent = "yellow" | "pink" | "blue" | "green" | "orange" | "lavender" | "none";

interface Props extends Omit<HTMLAttributes<"div">, "class"> {
  /** Wraps the card in an <a> when set, making the whole card clickable. */
  href?: string;
  eyebrow?: string;
  title?: string;
  description?: string;
  /** Flat accent fill for the card background. */
  accent?: Accent;
  /** Set false for static content containers (e.g. a form) that shouldn't hint at being clickable. */
  interactive?: boolean;
  class?: string;
}

const {
  href,
  eyebrow,
  title,
  description,
  accent = "none",
  interactive = true,
  class: className,
  ...rest
} = Astro.props;

// "none" (bg-paper) inverts correctly with the theme, so it keeps the
// inverting border-ink/text-ink. A real accent fill doesn't change between
// themes (see global.css), so it needs the fixed border-ink-on-accent/
// text-ink-on-accent instead, or its border and text would lose contrast
// against the fill in dark mode.
const surface: Record<Accent, string> = {
  yellow: "border-ink-on-accent bg-yellow text-ink-on-accent",
  pink: "border-ink-on-accent bg-pink text-ink-on-accent",
  blue: "border-ink-on-accent bg-blue text-ink-on-accent",
  green: "border-ink-on-accent bg-green text-ink-on-accent",
  orange: "border-ink-on-accent bg-orange text-ink-on-accent",
  lavender: "border-ink-on-accent bg-lavender text-ink-on-accent",
  none: "border-ink bg-paper text-ink",
};

const mutedText: Record<Accent, string> = {
  yellow: "text-ink-on-accent/80",
  pink: "text-ink-on-accent/80",
  blue: "text-ink-on-accent/80",
  green: "text-ink-on-accent/80",
  orange: "text-ink-on-accent/80",
  lavender: "text-ink-on-accent/80",
  none: "text-ink/80",
};

const Tag = href ? "a" : "div";

const base = "block border-[3px] p-6 shadow-brutal";
const interactivity =
  "transition-all duration-150 hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-brutal-lg";
---

<Tag class:list={[base, interactive && interactivity, surface[accent], className]} href={href} {...rest}>
  {
    eyebrow && (
      <span class="mb-2 inline-block border-2 border-ink bg-paper px-2 py-0.5 font-mono text-xs font-bold text-ink uppercase">
        {eyebrow}
      </span>
    )
  }
  <slot name="icon" />
  {title && <h3 class="font-heading text-xl font-bold">{title}</h3>}
  {description && <p class:list={["mt-2 text-pretty", mutedText[accent]]}>{description}</p>}
  <slot />
</Tag>
