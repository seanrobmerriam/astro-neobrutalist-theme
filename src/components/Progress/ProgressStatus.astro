---
interface Props {
  value: number;
  label?: string;
  class?: string;
}

const { value, label = "Progress", class: className } = Astro.props;
const labelId = `progress-${label.toLowerCase().replace(/\s+/g, "-")}`;
---

<div role="progressbar" aria-valuenow={value} aria-valuemin="0" aria-valuemax="100" aria-labelledby={labelId} class={className}>
  <div class="flex justify-between gap-4 text-ink">
    <span id={labelId} class="text-sm font-semibold">{label}</span>
    <span class="text-sm font-semibold">{value}%</span>
  </div>

  <div class="mt-2 w-full border-2 border-ink bg-paper p-1 shadow-brutal-sm">
    <div class="h-3 bg-green" style={`width: ${value}%`} />
  </div>
</div>
