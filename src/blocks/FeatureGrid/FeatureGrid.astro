---
import Card from "../../components/Card/Card.astro";
import Container from "../../components/Container/Container.astro";

type Accent = "yellow" | "pink" | "blue" | "green" | "orange" | "lavender";

interface Feature {
  title: string;
  description: string;
  accent?: Accent;
  href?: string;
}

interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  description?: string;
  features: Feature[];
  class?: string;
}

const { id, eyebrow, title, description, features, class: className } = Astro.props;

const accentCycle: Accent[] = ["yellow", "blue", "pink", "green", "orange", "lavender"];
---

<Container as="section" id={id} class:list={["py-20", className]}>
  {
    (eyebrow || title || description) && (
      <div class="mx-auto mb-14 max-w-2xl text-center">
        {eyebrow && (
          <span class="inline-block border-2 border-ink-on-accent bg-blue px-3 py-1 font-mono text-xs font-bold text-ink-on-accent uppercase tracking-wide shadow-brutal-sm">
            {eyebrow}
          </span>
        )}
        {title && <h2 class="mt-4 text-balance font-display text-section-lg font-extrabold uppercase">{title}</h2>}
        {description && <p class="mt-4 text-pretty text-ink/70">{description}</p>}
      </div>
    )
  }

  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      features.map((feature, i) => (
        <Card
          title={feature.title}
          description={feature.description}
          accent={feature.accent ?? accentCycle[i % accentCycle.length]}
          href={feature.href}
        />
      ))
    }
  </div>
</Container>
