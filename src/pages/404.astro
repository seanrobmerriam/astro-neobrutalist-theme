---
import LandingLayout from "../layouts/LandingLayout.astro";
import Button from "../components/Button/Button.astro";
import { site } from "../config/site";
---

<LandingLayout
  title={`Page not found — ${site.name}`}
  description="The page you're looking for doesn't exist."
  navLinks={site.nav}
>
  <div class="mx-auto flex max-w-2xl flex-col items-center gap-6 px-6 py-28 text-center">
    <span
      class="inline-block border-2 border-ink-on-accent bg-pink px-3 py-1 font-mono text-xs font-bold text-ink-on-accent uppercase tracking-wide shadow-brutal-sm"
    >
      404
    </span>
    <h1 class="text-balance font-display text-hero-centered font-extrabold uppercase">Page not found</h1>
    <p class="max-w-md text-pretty text-ink/70">
      Whatever you were looking for isn't here. It might have moved, or the link might be wrong.
    </p>
    <div class="mt-2 flex flex-wrap items-center justify-center gap-3">
      <Button href="/landing">Back to home</Button>
      <Button href="/docs" variant="outline">Read the docs</Button>
    </div>
  </div>
</LandingLayout>
