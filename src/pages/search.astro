---
import LandingLayout from "../layouts/LandingLayout.astro";
import Container from "../components/Container/Container.astro";
import { site } from "../config/site";
---

<LandingLayout
  title={`Search — ${site.name}`}
  description={`Search across every page of ${site.name}.`}
  navLinks={site.nav}
>
  <Container size="md" class="py-20">
    <div class="mb-10 text-center">
      <span
        class="inline-block border-2 border-ink-on-accent bg-lavender px-3 py-1 font-mono text-xs font-bold text-ink-on-accent uppercase tracking-wide shadow-brutal-sm"
      >
        Search
      </span>
      <h1 class="mt-4 text-balance font-display text-section-lg font-extrabold uppercase">Find anything</h1>
      <p class="mx-auto mt-4 max-w-md text-pretty text-ink/70">
        Full-text search across docs, blog posts, and every other page — indexed at build time, no service required.
      </p>
    </div>

    <div class="border-[3px] border-ink bg-paper p-6 shadow-brutal" id="search"></div>
  </Container>

  <!--
    Pagefind's UI assets (/pagefind/pagefind-ui.{js,css}) are generated by the
    `postbuild` script (`pagefind --site dist`) and only exist after a real
    `bun run build` — they 404 under `astro dev`. This page's search box is
    dev-server-empty by design; verify it with `bun run build && bun run preview`.
    Pagefind's own UI classes are left with their default styling rather than
    fully reskinned to match the neubrutalist system — the surrounding
    bordered box is the extent of the visual integration for now.
  -->
  <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
  <script src="/pagefind/pagefind-ui.js" is:inline></script>
  <script is:inline>
    window.addEventListener("DOMContentLoaded", () => {
      if (typeof PagefindUI === "function") {
        new PagefindUI({ element: "#search", showSubResults: true, showImages: false });
      }
    });
  </script>
</LandingLayout>
