---
import Button from "../../components/Button/Button.astro";
import Drawer from "../../components/Drawer/Drawer.astro";
import ThemeToggle from "../../components/ThemeToggle/ThemeToggle.astro";
import Container from "../../components/Container/Container.astro";
import Icon from "../../components/Icon/Icon.astro";

interface NavLink {
  label: string;
  href: string;
}

interface Props {
  brand: string;
  links?: NavLink[];
  ctaLabel?: string;
  ctaHref?: string;
  class?: string;
}

const { brand, links = [], ctaLabel, ctaHref, class: className } = Astro.props;

const drawerId = "mobile-nav";
---

<header class:list={["sticky top-0 z-30 border-b-[3px] border-ink bg-paper", className]}>
  <Container class="flex items-center justify-between py-4">
    <a href="/" class="font-display text-xl font-extrabold uppercase tracking-tight">{brand}</a>

    <nav class="hidden items-center gap-8 lg:flex" aria-label="Primary">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="font-heading font-semibold text-ink hover:underline hover:decoration-2 hover:underline-offset-4"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <ThemeToggle />

      <div class="hidden lg:block">
        {
          ctaLabel && ctaHref && (
            <Button href={ctaHref} size="sm">
              {ctaLabel}
            </Button>
          )
        }
      </div>

      <button
        type="button"
        data-dialog-open={drawerId}
        aria-label="Open menu"
        class="flex size-10 items-center justify-center border-2 border-ink bg-paper shadow-brutal-sm hover:bg-yellow lg:hidden"
      >
        <Icon name="menu" class="size-4" />
      </button>
    </div>
  </Container>
</header>

<Drawer id={drawerId} title="Menu" side="right">
  <nav class="flex flex-col gap-5" aria-label="Mobile">
    {
      links.map((link) => (
        <a href={link.href} class="font-heading text-lg font-semibold text-ink">
          {link.label}
        </a>
      ))
    }
  </nav>

  {
    ctaLabel && ctaHref && (
      <div class="mt-8">
        <Button href={ctaHref} class="w-full justify-center">
          {ctaLabel}
        </Button>
      </div>
    )
  }
</Drawer>
