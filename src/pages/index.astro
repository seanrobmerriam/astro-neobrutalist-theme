---
import LandingLayout from "../layouts/LandingLayout.astro";
import ShowcaseSection from "./_partials/ShowcaseSection.astro";
import { site } from "../config/site";

import Hero from "../blocks/Hero/Hero.astro";
import FeatureGrid from "../blocks/FeatureGrid/FeatureGrid.astro";
import CTA from "../blocks/CTA/CTA.astro";

import Button from "../components/Button/Button.astro";

import Badge from "../components/Badge/Badge.astro";
import BadgeDismiss from "../components/Badge/BadgeDismiss.astro";
import BadgeStatus from "../components/Badge/BadgeStatus.astro";

import Card from "../components/Card/Card.astro";
import CardMessage from "../components/Card/CardMessage.astro";
import CardStacked from "../components/Card/CardStacked.astro";

import Avatar from "../components/Avatar/Avatar.astro";
import List from "../components/List/List.astro";

import Accordion from "../components/Accordion/Accordion.astro";

import Tabs from "../components/Tab/Tabs.astro";

import InputForm from "../components/Input/InputForm.astro";
import InputFormIcon from "../components/Input/InputFormIcon.astro";
import InputFormSearch from "../components/Input/InputFormSearch.astro";
import TextArea from "../components/TextArea/TextArea.astro";
import Checkbox from "../components/Checkbox/Checkbox.astro";
import CheckboxGroup from "../components/Checkbox/CheckboxGroup.astro";
import Select from "../components/Forms/Select.astro";
import RadioGroup from "../components/Forms/RadioGroup.astro";

import Table from "../components/Table/Table.astro";
import Progress from "../components/Progress/Progress.astro";
import ProgressStatus from "../components/Progress/ProgressStatus.astro";
import Alert from "../components/Alerts/Alert.astro";

import Modal from "../components/Modal/Modal.astro";
import Drawer from "../components/Drawer/Drawer.astro";
import SpeedDial from "../components/SpeedDial/SpeedDial.astro";

import Carousel from "../components/Carousel/Carousel.astro";
import CarouselSlide from "../components/Carousel/CarouselSlide.astro";
import Gallery from "../components/Gallery/Gallery.astro";

import Terminal from "../components/Terminal/Terminal.astro";
import buttonSource from "../components/Button/Button.astro?raw";

import WTerminal from "../blocks/Terminal/WTermBash.astro";
import buttonCode from '../components/Button/Button.astro?raw';

const accentHex: Record<string, string> = {
  yellow: "#FFD23F",
  pink: "#FF6B6B",
  blue: "#74B9FF",
  green: "#88D498",
  orange: "#FFA552",
  lavender: "#BBA9FA",
};

// Static class-name map for the "Everything you get" stat numbers. The
// dynamic `text-${accent}` template-literal approach silently drops the
// classes Tailwind v4's JIT scanner can't see at build time — three of the
// six rendered black. Using a literal lookup here keeps every class name
// visible to the scanner.
const accentTextClasses = [
  "text-yellow",
  "text-pink",
  "text-blue",
  "text-green",
  "text-orange",
  "text-lavender",
] as const;

function placeholderImage(label: string, hex: string) {
  const svg = `<svg xmlns='http://www.w3.org/2000/svg' width='400' height='400'><rect width='400' height='400' fill='${hex}'/><text x='50%' y='53%' font-family='monospace' font-size='120' font-weight='700' fill='black' text-anchor='middle' dominant-baseline='middle'>${label}</text></svg>`;
  return `data:image/svg+xml,${encodeURIComponent(svg)}`;
}

const galleryImages = [
  { src: placeholderImage("01", accentHex.yellow), alt: "Yellow poster tile 01" },
  { src: placeholderImage("02", accentHex.pink), alt: "Pink poster tile 02" },
  { src: placeholderImage("03", accentHex.blue), alt: "Blue poster tile 03" },
  { src: placeholderImage("04", accentHex.green), alt: "Green poster tile 04" },
  { src: placeholderImage("05", accentHex.orange), alt: "Orange poster tile 05" },
  { src: placeholderImage("06", accentHex.lavender), alt: "Lavender poster tile 06" },
];

const tableColumns = [
  { key: "name", label: "Name" },
  { key: "role", label: "Role" },
  { key: "status", label: "Status" },
];

const tableRows = [
  { name: "Ava Stone", role: "Design Lead", status: { text: "Active", tone: "green" as const } },
  { name: "Marcus Lin", role: "Engineer", status: { text: "Active", tone: "green" as const } },
  { name: "Priya Anand", role: "Product", status: { text: "Invited", tone: "blue" as const } },
  { name: "Theo Brandt", role: "Engineer", status: { text: "Suspended", tone: "pink" as const } },
];

const navLinks = [
  { label: "Components", href: "#buttons" },
  { label: "Forms", href: "#forms" },
  { label: "Overlays", href: "#overlays" },
  { label: "Docs", href: "/docs" },
];

// Theme features highlighted in the "Why this theme" section — every one of
// these maps to a real, demonstrable surface on this page or in the docs,
// not invented copy. If a feature is added or removed here, the matching
// demo block below should be updated so the two don't drift.
const themeFeatures = [
  {
    title: "40+ typed Astro components",
    description: "Buttons, cards, forms, modals, tables, tabs — all typed, slotted, and copy-paste ready.",
  },
  {
    title: "Tailwind v4 @theme tokens",
    description:
      "Six categorical accents, two inverting neutrals, and a three-tier hard-offset shadow scale — every component reads from the same tokens.",
  },
  {
    title: "Zero client JS by default",
    description:
      "Pages ship as static HTML. Interactivity (modals, drawers, tabs, gallery) is opt-in via shared data-* attributes.",
  },
  {
    title: "Composable blocks & layouts",
    description: "Hero, Navbar, Pricing, FAQ, CTA, Footer — blocks built from the same primitives you get.",
  },
  {
    title: "Accessible by construction",
    description: "Visible focus rings, contrast-checked tokens, semantic HTML, keyboard-friendly overlays — by default.",
  },
  {
    title: "Self-hosted fonts",
    description:
      "Display, body, and mono fonts are loaded via Astro's Fonts API — no runtime request to Google, no render-blocking external CSS.",
  },
];

// What's actually in the theme — surfaces the buyer is buying, not invented
// filler. Counts are illustrative placeholders; the README and the showcase
// below are the real source of truth and should be kept in sync.
const whatsInside = [
  { title: "Components", count: "40+" },
  { title: "Blocks", count: "7" },
  { title: "Layouts", count: "3" },
  { title: "Pages", count: "15" },
  { title: "Color tokens", count: "9" },
  { title: "Shadow tiers", count: "4" },
];

const footerGroups = [
  {
    heading: "Theme",
    links: [
      { label: "Components", href: "#buttons" },
      { label: "Forms", href: "#forms" },
      { label: "Overlays", href: "#overlays" },
    ],
  },
  {
    heading: "Buy",
    links: [
      { label: "Pricing", href: "/pricing" },
      { label: "Buy Theme", href: "/buy" },
      { label: "Docs", href: "/docs" },
    ],
  },
  site.footerResources,
];
---

<LandingLayout
  title={`${site.name} — Astro Neubrutalist Theme`}
  description="A complete neubrutalist design system for Astro: components, blocks, and layouts built with Tailwind CSS v4."
  navLinks={navLinks}
  navCtaLabel="Buy Theme"
  navCtaHref="/buy"
  footerGroups={footerGroups}
>
  <Hero
    id="top"
    eyebrow="Astro + Tailwind CSS v4"
    title="The neubrutalist theme with the components built in."
    subtitle="Thick borders, hard shadows, and flat color — a complete Astro component library, block set, and layout. Pick a tier, copy the components, ship."
    primaryCta={{ label: "Buy Theme", href: "/buy" }}
    secondaryCta={{ label: "Browse components", href: "#buttons" }}
  />

  <FeatureGrid
    id="features"
    eyebrow="Theme features"
    title="Why this theme"
    description="The features that come with every license tier — typed props, theme tokens, and zero-JS interactivity, all wired up out of the box."
    features={themeFeatures}
  />

  <ShowcaseSection
    id="inside"
    eyebrow="What's in the box"
    title="Everything you get"
    description="The actual surfaces that ship with the theme — counts are illustrative, scroll down to see every one."
    tone="paper"
  >
    <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
      {
        whatsInside.map((item, i) => (
          <li class="border-[3px] border-ink bg-paper p-5 shadow-brutal-sm">
            <p class:list={["font-display text-4xl font-extrabold uppercase", accentTextClasses[i % accentTextClasses.length]]}>
              {item.count}
            </p>
            <p class="mt-1 font-heading text-sm font-bold uppercase tracking-wide text-ink/80">{item.title}</p>
          </li>
        ))
      }
    </ul>
  </ShowcaseSection>

  <ShowcaseSection
    id="gallery"
    eyebrow="Components"
    title="Gallery"
    description="A responsive image grid with keyboard-navigable lightbox — open any tile to view it full-size, then arrow through the rest without leaving the dialog."
  >
    <Gallery images={galleryImages} columns={3} />
  </ShowcaseSection>

  <ShowcaseSection
    id="buttons"
    eyebrow="Components"
    title="Buttons"
    description="One reusable Button with eight variants and three sizes — grouped here by how you'd actually reach for them."
  >
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <Card interactive={false} class="p-0!">
        <div class="flex flex-col gap-4 p-6">
          <div>
            <h3 class="font-heading text-lg font-bold">Primary &amp; Secondary</h3>
            <p class="mt-1 text-sm text-ink/70">The default action, and its secondary counterpart.</p>
          </div>
          <div class="flex flex-wrap items-center gap-3">
            <Button variant="primary">Primary</Button>
            <Button variant="secondary">Secondary</Button>
          </div>
        </div>
      </Card>

      <Card interactive={false} class="p-0!">
        <div class="flex flex-col gap-4 p-6">
          <div>
            <h3 class="font-heading text-lg font-bold">Outline &amp; Borderless</h3>
            <p class="mt-1 text-sm text-ink/70">Lower-emphasis actions for dense layouts.</p>
          </div>
          <div class="flex flex-wrap items-center gap-3">
            <Button variant="outline">Outline</Button>
            <Button variant="borderless">Borderless</Button>
          </div>
        </div>
      </Card>

      <Card interactive={false} class="p-0!">
        <div class="flex flex-col gap-4 p-6">
          <div>
            <h3 class="font-heading text-lg font-bold">Sizes</h3>
            <p class="mt-1 text-sm text-ink/70">Small, medium, and large — same variant, different scale.</p>
          </div>
          <div class="flex flex-wrap items-end gap-3">
            <Button size="sm">Small</Button>
            <Button size="md">Medium</Button>
            <Button size="lg">Large</Button>
          </div>
        </div>
      </Card>

      <Card interactive={false} class="p-0!">
        <div class="flex flex-col gap-4 p-6">
          <div>
            <h3 class="font-heading text-lg font-bold">Danger</h3>
            <p class="mt-1 text-sm text-ink/70">Reserved for destructive, hard-to-undo actions.</p>
          </div>
          <Alert variant="error" message="This will permanently delete your account." />
          <Button variant="danger" class="w-full justify-center"> Delete account </Button>
        </div>
      </Card>

      <Card interactive={false} class="p-0!">
        <div class="flex flex-col gap-4 p-6">
          <div>
            <h3 class="font-heading text-lg font-bold">Success</h3>
            <p class="mt-1 text-sm text-ink/70">Confirms a completed, positive outcome.</p>
          </div>
          <Alert variant="success" message="Your changes have been saved." />
          <Button variant="success" class="w-full justify-center"> Continue </Button>
        </div>
      </Card>

      <Card interactive={false} class="p-0!">
        <div class="flex flex-col gap-4 p-6">
          <div>
            <h3 class="font-heading text-lg font-bold">Warning</h3>
            <p class="mt-1 text-sm text-ink/70">Flags a risky action before it's taken.</p>
          </div>
          <Alert variant="warning" message="You're about to leave without saving." />
          <Button variant="warning" class="w-full justify-center"> Leave anyway </Button>
        </div>
      </Card>
    </div>
  </ShowcaseSection>

  <ShowcaseSection
    id="badges"
    eyebrow="Components"
    title="Badges"
    description="Three ways to attach a small, flat-color label to real content."
  >
    <div class="grid gap-6 sm:grid-cols-3">
      <Card interactive={false} class="p-0!">
        <div class="flex flex-col gap-3 p-6">
          <h3 class="font-heading text-lg font-bold">Tags</h3>
          <div class="flex items-center gap-2">
            <Badge label="New" accent="yellow" />
            <span class="font-heading font-bold">Astro 5.0 is here</span>
          </div>
          <p class="text-sm text-ink/70">A quick look at what shipped in the latest major release.</p>
        </div>
      </Card>

      <Card interactive={false} class="p-0!">
        <div class="flex flex-col gap-3 p-6">
          <h3 class="font-heading text-lg font-bold">Dismissible filters</h3>
          <p class="text-sm text-ink/70">Active filters, removable inline.</p>
          <div class="flex flex-wrap gap-2">
            <BadgeDismiss label="React" />
            <BadgeDismiss label="Under $50" />
          </div>
        </div>
      </Card>

      <Card interactive={false} class="p-0!">
        <div class="flex flex-col gap-3 p-6">
          <h3 class="font-heading text-lg font-bold">Status indicators</h3>
          <p class="text-sm text-ink/70">Live system state, at a glance.</p>
          <div class="flex flex-col gap-2">
            <div class="flex items-center justify-between">
              <span class="text-sm font-medium">API</span>
              <BadgeStatus label="Operational" status="online" />
            </div>
            <div class="flex items-center justify-between">
              <span class="text-sm font-medium">Build queue</span>
              <BadgeStatus label="Degraded" status="busy" />
            </div>
          </div>
        </div>
      </Card>
    </div>
  </ShowcaseSection>

  <ShowcaseSection
    id="cards"
    eyebrow="Components"
    title="Cards"
    description="One base Card, a couple of content-specific variants, and a few things you can build from just the base."
  >
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <Card
        eyebrow="Design"
        title="Composable by default"
        description="Pass a title, description, and accent — or drop in your own markup via slots."
        accent="yellow"
      />

      <CardMessage
        title="Deploy succeeded"
        message="neubrutal-theme was built and deployed in 42 seconds. No warnings, no errors."
      />

      <CardStacked
        date="2026-08-16"
        dateLabel="Aug 16, 2026"
        title="Shipping a full component library in a weekend"
        description="Notes on building buttons, cards, and forms fast without reaching for a UI kit."
      />

      <Card interactive={false} class="p-0!">
        <div class="p-6">
          <span
            class="inline-block border-2 border-ink bg-lavender px-3 py-1 font-mono text-xs font-bold tracking-wide uppercase shadow-brutal-sm"
          >
            Pro
          </span>
          <p class="mt-4 font-display text-4xl font-extrabold">
            $29<span class="font-heading text-base font-semibold text-ink/60">/mo</span>
          </p>
          <p class="mt-2 text-sm text-ink/70">Everything in Free, plus unlimited projects and priority support.</p>
          <Button variant="primary" class="mt-4 w-full justify-center"> Choose Pro </Button>
        </div>
      </Card>

      <Card interactive={false} accent="green" class="flex flex-col items-center justify-center text-center">
        <p class="font-display text-5xl font-extrabold">42+</p>
        <p class="mt-2 font-mono text-xs font-bold tracking-wide uppercase">Components shipped</p>
      </Card>

      <Card
        interactive={false}
        accent="blue"
        title="Lightning setup"
        description="Install once, theme everything from a single CSS file."
      >
        <svg slot="icon" aria-hidden="true" viewBox="0 0 16 16" fill="currentColor" class="mb-3 size-8">
          <path
            fill-rule="evenodd"
            d="M9.5 1.5a.5.5 0 0 0-.947-.226l-6 12a.5.5 0 0 0 .447.726H6.5v4.5a.5.5 0 0 0 .947.226l6-12a.5.5 0 0 0-.447-.726H9.5v-4.5Z"
            clip-rule="evenodd"></path>
        </svg>
      </Card>
    </div>
  </ShowcaseSection>

  <ShowcaseSection id="avatars-lists" eyebrow="Components" title="Avatars & Lists">
    <div>
      <p class="mb-4 font-mono text-xs font-bold uppercase tracking-wide opacity-60">Sizes & shapes</p>
      <div class="grid gap-4 sm:grid-cols-3">
        <Card interactive={false} class="flex flex-col items-center gap-2 text-center">
          <Avatar name="Ava Stone" size="sm" accent="yellow" />
          <p class="font-heading text-sm font-bold">Ava Stone</p>
          <p class="text-xs text-ink/60">Design Lead</p>
        </Card>
        <Card interactive={false} class="flex flex-col items-center gap-2 text-center">
          <Avatar name="Marcus Lin" size="md" accent="blue" />
          <p class="font-heading text-sm font-bold">Marcus Lin</p>
          <p class="text-xs text-ink/60">Engineer</p>
        </Card>
        <Card interactive={false} class="flex flex-col items-center gap-2 text-center">
          <Avatar name="Priya Anand" size="lg" accent="pink" shape="circle" />
          <p class="font-heading text-sm font-bold">Priya Anand</p>
          <p class="text-xs text-ink/60">Product</p>
        </Card>
      </div>
    </div>

    <div class="mt-10 grid gap-10 lg:grid-cols-[2fr_1fr]">
      <div>
        <p class="mb-4 font-mono text-xs font-bold uppercase tracking-wide opacity-60">AI agent chat</p>
        <div class="flex h-[600px] flex-col border-[3px] border-ink bg-paper shadow-brutal" data-agent-chat>
          <header class="flex items-center gap-3 border-b-[3px] border-ink bg-lavender px-4 py-3">
            <div class="flex size-10 shrink-0 items-center justify-center border-2 border-ink bg-paper font-mono text-sm font-bold shadow-brutal-sm">
              AI
            </div>
            <div class="min-w-0 flex-1">
              <p class="font-heading font-bold">Neubrutal Agent</p>
              <p class="text-xs text-ink/60">
                <span class="inline-block size-2 bg-green align-middle"></span>
                Online · reads your repo, runs tools, replies in seconds
              </p>
            </div>
            <button
              type="button"
              class="border-2 border-ink bg-paper px-3 py-1 font-mono text-xs font-bold uppercase shadow-brutal-sm hover:bg-yellow"
              onclick="document.querySelector('[data-agent-thread]').innerHTML = ''; document.querySelector('[data-agent-empty]').hidden = false;"
            >
              Reset
            </button>
          </header>

          <div data-agent-thread class="flex-1 space-y-4 overflow-y-auto p-4">
            <div data-agent-empty class="flex h-full flex-col items-center justify-center gap-4 text-center">
              <div class="flex size-14 items-center justify-center border-[3px] border-ink bg-lavender font-display text-2xl font-extrabold uppercase shadow-brutal">
                AI
              </div>
              <div class="max-w-sm">
                <p class="font-heading text-lg font-bold">Start a conversation</p>
                <p class="mt-1 text-sm text-ink/70">
                  Ask about the theme, the components, or how to wire up HTMX. Replies are powered by a tiny in-memory
                  mock so the demo works offline — swap the endpoint for your LLM of choice.
                </p>
              </div>
              <div class="flex flex-wrap justify-center gap-2">
                {
                  [
                    "What can this theme do?",
                    "How do the components stay zero-JS?",
                    "Tell me about the color tokens",
                    "How would I deploy this?",
                  ].map((prompt) => (
                    <button
                      type="button"
                      class="border-2 border-ink bg-paper px-3 py-2 text-xs font-semibold shadow-brutal-sm hover:bg-yellow"
                      data-suggested-prompt
                      onclick={`document.getElementById('agent-input').value = ${JSON.stringify(prompt)}; document.getElementById('agent-input').focus()`}
                    >
                      {prompt}
                    </button>
                  ))
                }
              </div>
            </div>
          </div>

          <form
            id="agent-form"
            class="flex items-end gap-3 border-t-[3px] border-ink bg-paper p-3"
            data-agent-form
          >
            <button
              type="button"
              class="flex size-10 shrink-0 items-center justify-center border-2 border-ink bg-paper shadow-brutal-sm hover:bg-yellow"
              aria-label="Attach a file"
            >
              <span class="font-mono text-lg font-bold">+</span>
            </button>
            <textarea
              id="agent-input"
              name="message"
              rows="1"
              placeholder="Ask anything…"
              required
              class="max-h-32 min-h-10 flex-1 resize-none border-2 border-ink bg-paper px-3 py-2 text-sm shadow-brutal-sm focus:outline-none focus-visible:shadow-brutal"
              onkeydown="(function(e){if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();this.closest('form').requestSubmit();}}).call(this,arguments[0])"
            ></textarea>
            <button
              type="submit"
              class="flex size-10 shrink-0 items-center justify-center border-2 border-ink bg-yellow shadow-brutal-sm hover:bg-green"
              aria-label="Send message"
              onclick="setTimeout(() => { const t = document.createElement('div'); t.dataset.typing = ''; t.className = 'flex items-start gap-3'; t.innerHTML = '<div class=&quot;flex size-8 shrink-0 items-center justify-center border-2 border-ink bg-lavender font-mono text-xs font-bold shadow-brutal-sm&quot;>AI</div><div class=&quot;flex items-center gap-1 self-center text-sm text-ink/60&quot;><span class=&quot;inline-block size-2 animate-bounce bg-ink&quot; style=&quot;animation-delay:0ms&quot;></span><span class=&quot;inline-block size-2 animate-bounce bg-ink&quot; style=&quot;animation-delay:120ms&quot;></span><span class=&quot;inline-block size-2 animate-bounce bg-ink&quot; style=&quot;animation-delay:240ms&quot;></span></div>'; document.querySelector('[data-agent-thread]')?.appendChild(t); }, 50)"
            >
              <span class="font-mono text-base font-bold">→</span>
            </button>
          </form>
        </div>
      </div>

      <div>
        <p class="mb-4 font-mono text-xs font-bold uppercase tracking-wide opacity-60">Capabilities</p>
        <Card interactive={false} class="p-0!">
          <div class="p-6">
            <h3 class="font-heading text-lg font-bold">What this agent can do</h3>
            <p class="mt-1 text-sm text-ink/70">
              The endpoint at <code class="font-mono text-xs">/api/chat/[i].ts</code> is a prerendered Astro API
              route. The client hashes your input to pick a reply — swap the <code class="font-mono text-xs">REPLIES</code>
              array for an LLM call to ship.
            </p>
            <List
              variant="check"
              class="mt-4"
              items={[
                { text: "Suggested prompts", description: "Four click-to-fill chips replace the empty state." },
                { text: "Streaming-ready markup", description: "Each reply is an HTML fragment returned from a route." },
                { text: "Typing indicator", description: "Three-dot bounce renders during the round-trip." },
                { text: "Shift+Enter for newline", description: "Enter submits, Shift+Enter inserts a line break." },
                { text: "Reset conversation", description: "Clear the thread without reloading the page." },
              ]}
            />
          </div>
        </Card>
      </div>
    </div>
  </ShowcaseSection>

  <ShowcaseSection id="tabs-accordion" eyebrow="Components" title="Tabs & Accordion">
    <div class="grid gap-10 lg:grid-cols-2">
      <div class="border-[3px] border-ink bg-paper p-6 text-ink shadow-brutal-lg">
        <Tabs
          tabs={[
            {
              label: "Profile",
              content: "Every component accepts typed props — this panel is just one of them, swapped in on click.",
            },
            {
              label: "Account",
              content: "No client framework required: a few lines of vanilla JS handle the switching and ARIA state.",
            },
            {
              label: "Notifications",
              content:
                "Panels are hidden with the native hidden attribute, so there's nothing to hydrate and nothing to flash.",
            },
          ]}
        />
      </div>
      <div class="flex flex-col gap-4">
        <Accordion />
        <Accordion
          variant="grouped"
          items={[
            {
              question: "Does it work with content collections?",
              answer:
                "Yes — components are plain Astro files with typed props, so they compose with content collections, server islands, or any framework component the same way any other Astro component would.",
            },
            {
              question: "Can I change the color palette?",
              answer:
                "Every color is a single OKLCH token in global.css — swap the values there and the whole theme follows.",
            },
            {
