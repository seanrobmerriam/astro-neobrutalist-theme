---
import LandingLayout from "../layouts/LandingLayout.astro";
import Container from "../components/Container/Container.astro";
import Card from "../components/Card/Card.astro";
import InputForm from "../components/Input/InputForm.astro";
import TextArea from "../components/TextArea/TextArea.astro";
import Button from "../components/Button/Button.astro";
import { site } from "../config/site";

const footerGroups = [
  {
    heading: "Company",
    links: [
      { label: "About", href: "/about" },
      { label: "Team", href: "/team" },
      { label: "Contact", href: "/contact" },
    ],
  },
  site.footerResources,
];
---

<LandingLayout
  title={`Contact — ${site.name}`}
  description={`Get in touch with the ${site.name} team.`}
  navLinks={site.nav}
  footerGroups={footerGroups}
>
  <Container size="sm" class="py-20">
    <div class="mb-10 text-center">
      <span
        class="inline-block border-2 border-ink-on-accent bg-orange px-3 py-1 font-mono text-xs font-bold text-ink-on-accent uppercase tracking-wide shadow-brutal-sm"
      >
        Contact
      </span>
      <h1 class="mt-4 text-balance font-display text-section-lg font-extrabold uppercase">Get in touch</h1>
      <p class="mx-auto mt-4 max-w-md text-pretty text-ink/70">
        Questions about a license, a bug, or a feature you wish existed — this goes straight to the two of us.
      </p>
    </div>

    <Card interactive={false}>
      <form id="contact-form" class="flex flex-col gap-5">
        <InputForm label="Name" id="contact-name" name="name" autocomplete="name" required />
        <InputForm label="Email" id="contact-email" name="email" type="email" autocomplete="email" required />
        <TextArea label="Message" id="contact-message" name="message" rows={5} required />
        <Button type="submit" class="w-full justify-center">Send message</Button>
      </form>
    </Card>
  </Container>

  <script>
    // Demo-only: this form has no real backend to submit to — wire it up to
    // your own endpoint (or a service like Formspree) before shipping. The
    // toast here just proves the Forms/Toast/Button composition works.
    document.getElementById("contact-form")?.addEventListener("submit", (event) => {
      event.preventDefault();
      window.showToast?.({
        title: "Message sent",
        description: "We'll get back to you within a couple of days.",
        variant: "success",
      });
      (event.target as HTMLFormElement).reset();
    });
  </script>
</LandingLayout>
