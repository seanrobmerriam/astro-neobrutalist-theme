---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<button
  type="button"
  data-theme-toggle
  aria-label="Toggle color theme"
  class:list={[
    "flex size-10 items-center justify-center border-2 border-ink bg-paper shadow-brutal-sm hover:bg-yellow focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus-ring",
    className,
  ]}
>
  <svg
    data-icon="system"
    viewBox="0 0 16 16"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    class="size-4"
    aria-hidden="true"
  >
    <rect x="1.5" y="2.5" width="13" height="9" stroke-linejoin="round"></rect>
    <path d="M5.5 14.5h5M8 11.5v3" stroke-linecap="round"></path>
  </svg>
  <svg
    data-icon="light"
    viewBox="0 0 16 16"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    class="size-4"
    aria-hidden="true"
  >
    <circle cx="8" cy="8" r="3.25"></circle>
    <path
      d="M8 1v1.5M8 13.5V15M15 8h-1.5M2.5 8H1M12.9 3.1l-1.06 1.06M4.16 11.84l-1.06 1.06M12.9 12.9l-1.06-1.06M4.16 4.16 3.1 3.1"
      stroke-linecap="round"></path>
  </svg>
  <svg
    data-icon="dark"
    viewBox="0 0 16 16"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    class="size-4"
    aria-hidden="true"
  >
    <path d="M13.5 9.4A5.6 5.6 0 1 1 6.6 2.5a4.4 4.4 0 0 0 6.9 6.9Z" stroke-linejoin="round"></path>
  </svg>
</button>

<style>
  [data-theme-toggle] svg {
    display: none;
  }
  [data-theme-toggle]:not([data-current-theme]) svg[data-icon="system"],
  [data-theme-toggle][data-current-theme="system"] svg[data-icon="system"] {
    display: block;
  }
  [data-theme-toggle][data-current-theme="light"] svg[data-icon="light"] {
    display: block;
  }
  [data-theme-toggle][data-current-theme="dark"] svg[data-icon="dark"] {
    display: block;
  }
</style>

<script>
  import "../../scripts/theme-toggle";
</script>
