    id="reactivity"
    eyebrow="Reactivity"
    title="Server-driven, with HTMX"
    description="Optional reactivity for the few components that need to move without a framework runtime — backed by prerendered endpoints under /api."
  >
    <script>
      // HTMX powers the three demos below: a moving progress bar, toasts
      // that fire on a timer, and a carousel that streams additional slides.
      // It's imported once at the page level rather than globally so other
      // pages don't pay for the bytes.
      import "htmx.org";
    </script>

    <div class="grid gap-10 lg:grid-cols-3">
      <div>
        <p class="mb-4 font-mono text-xs font-bold uppercase tracking-wide opacity-60">Progress on demand</p>
        <Card interactive={false} class="p-0!">
          <div class="flex flex-col gap-5 p-6">
            <p class="text-sm text-ink/70">
              Click the button to advance a server-rendered progress bar. Each click hits a prerendered
              <code class="font-mono text-xs">/api/progress/N</code> endpoint and HTMX swaps in the new fragment.
            </p>

            <div
              hx-get="/api/progress/0"
              hx-trigger="load"
              hx-swap="outerHTML"
            >
              <div class="w-full border-2 border-ink bg-paper p-1 shadow-brutal-sm">
                <div class="h-3 bg-blue" style="width: 0%"></div>
              </div>
              <p class="text-sm text-ink/50">Loading…</p>
            </div>

            <details class="border-2 border-ink p-3">
              <summary class="cursor-pointer text-sm font-semibold">How this works</summary>
              <p class="mt-2 text-sm text-ink/70">
                <code class="font-mono text-xs">src/pages/api/progress/[v].ts</code> is a prerendered Astro API route
                with <code class="font-mono text-xs">getStaticPaths</code> emitting one file per progress step
                (0 → 8 → 18 → … → 100). Each fragment's button has <code class="font-mono text-xs">hx-get</code>
                pointing at the next step, so HTMX walks the sequence with zero custom JS.
              </p>
            </details>
          </div>
        </Card>
      </div>

      <div>
        <p class="mb-4 font-mono text-xs font-bold uppercase tracking-wide opacity-60">Toasts on a timer</p>
        <Card interactive={false} class="p-0!">
          <div class="flex flex-col gap-5 p-6">
            <p class="text-sm text-ink/70">
              Press start to receive a fresh toast every three seconds. Each one comes from a prerendered endpoint that
              rotates through a sequence of canned messages.
            </p>

            <div class="flex flex-wrap items-center gap-2">
              <button
                type="button"
                hx-get="/api/toast/0"
                hx-trigger="click"
                hx-swap="beforeend"
                hx-target="#ht-toast-stream"
                class="border-2 border-ink bg-yellow px-4 py-2 font-heading text-sm font-semibold shadow-brutal-sm hover:-translate-x-0.5 hover:-translate-y-0.5"
              >
                Start
              </button>
              <button
                type="button"
                onclick="document.querySelectorAll('#ht-toast-stream [role=status]').forEach((t) => t.remove())"
                class="border-2 border-ink bg-paper px-4 py-2 font-heading text-sm font-semibold shadow-brutal-sm hover:bg-pink"
              >
                Clear
              </button>
              <span class="ml-auto font-mono text-xs uppercase text-ink/60">/api/toast/N</span>
            </div>

            <div
              id="ht-toast-stream"
              class="flex min-h-32 flex-col items-stretch gap-2 border-2 border-dashed border-ink/30 p-3"
            >
              <p class="self-center text-center text-sm text-ink/40">Toasts will land here.</p>
            </div>

            <details class="border-2 border-ink p-3">
              <summary class="cursor-pointer text-sm font-semibold">How this works</summary>
              <p class="mt-2 text-sm text-ink/70">
                Each toast fragment includes a hidden button with
                <code class="font-mono text-xs">hx-get="/api/toast/N+1"</code> and
                <code class="font-mono text-xs">hx-trigger="every 3s"</code> — clicking <em>Start</em> appends the
                first toast, and the hidden trigger inside it keeps appending the next one every 3 seconds. No timer,
                no client state.
              </p>
            </details>
          </div>
        </Card>
      </div>

      <div>
        <p class="mb-4 font-mono text-xs font-bold uppercase tracking-wide opacity-60">Streamed carousel</p>
        <Card interactive={false} class="p-0!">
          <div class="flex flex-col gap-5 p-6">
            <p class="text-sm text-ink/70">
              The track starts with three slides and asks the server for two more when you click
              <em>Load more</em>. Each batch is HTML rendered by an Astro endpoint.
            </p>

            <div class="overflow-x-auto border-2 border-ink">
              <div class="flex snap-x snap-mandatory" data-htmx-carousel>
                <div class="w-full shrink-0 snap-start px-2 sm:w-1/2 lg:w-1/3">
                  <div class="h-full border-[3px] border-ink bg-yellow p-4 shadow-brutal">
                    <p class="font-heading text-base font-bold">"Slide one — server-driven."</p>
                    <p class="mt-2 text-xs text-ink/70">— preloaded in HTML</p>
                  </div>
                </div>
                <div class="w-full shrink-0 snap-start px-2 sm:w-1/2 lg:w-1/3">
                  <div class="h-full border-[3px] border-ink bg-blue p-4 shadow-brutal">
                    <p class="font-heading text-base font-bold">"Slide two — also preloaded."</p>
                    <p class="mt-2 text-xs text-ink/70">— preloaded in HTML</p>
                  </div>
                </div>
                <div class="w-full shrink-0 snap-start px-2 sm:w-1/2 lg:w-1/3">
                  <div class="h-full border-[3px] border-ink bg-pink p-4 shadow-brutal">
                    <p class="font-heading text-base font-bold">"Slide three — preloaded too."</p>
                    <p class="mt-2 text-xs text-ink/70">— preloaded in HTML</p>
                  </div>
                </div>
              </div>
            </div>

            <div class="flex items-center justify-between">
              <button
                type="button"
                hx-get="/api/carousel/0"
                hx-trigger="click"
                hx-swap="beforeend"
                hx-target="[data-htmx-carousel]"
                class="border-2 border-ink bg-paper px-4 py-2 font-heading text-sm font-semibold shadow-brutal-sm hover:bg-green"
              >
                Load 2 more
              </button>
              <span class="font-mono text-xs uppercase text-ink/60">/api/carousel/N</span>
