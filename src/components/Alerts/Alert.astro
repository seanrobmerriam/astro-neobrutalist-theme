---
type Variant = "info" | "success" | "warning" | "error";

interface Props {
  variant?: Variant;
  message: string;
  class?: string;
}

const { variant = "info", message, class: className } = Astro.props;

const accents: Record<Variant, string> = {
  info: "bg-blue",
  success: "bg-green",
  warning: "bg-orange",
  error: "bg-pink",
};
---

<div
  role="alert"
  class:list={[
    "flex items-start gap-3 border-2 border-ink-on-accent p-4 text-ink-on-accent shadow-brutal",
    accents[variant],
    className,
  ]}
>
  {
    variant === "info" && (
      <svg aria-hidden="true" viewBox="0 0 16 16" fill="currentColor" class="mt-0.5 size-4 shrink-0">
        <path
          fill-rule="evenodd"
          d="M15 8A7 7 0 1 1 1 8a7 7 0 0 1 14 0ZM9 5a1 1 0 1 1-2 0 1 1 0 0 1 2 0ZM6.75 8a.75.75 0 0 0 0 1.5h.75v1.75a.75.75 0 0 0 1.5 0v-2.5A.75.75 0 0 0 8.25 8h-1.5Z"
          clip-rule="evenodd"
        />
      </svg>
    )
  }
  {
    variant === "success" && (
      <svg
        aria-hidden="true"
        viewBox="0 0 16 16"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="mt-0.5 size-4 shrink-0"
      >
        <circle cx="8" cy="8" r="6.25" />
        <path d="M5.25 8.25l1.75 1.75 3.75-4" />
      </svg>
    )
  }
  {
    variant === "warning" && (
      <svg
        aria-hidden="true"
        viewBox="0 0 16 16"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="mt-0.5 size-4 shrink-0"
      >
        <path d="M8 1.5 1.5 13.5h13L8 1.5Z" />
        <path d="M8 6.25v3" />
        <path d="M8 11.5h.01" stroke-width="2.5" />
      </svg>
    )
  }
  {
    variant === "error" && (
      <svg
        aria-hidden="true"
        viewBox="0 0 16 16"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="mt-0.5 size-4 shrink-0"
      >
        <circle cx="8" cy="8" r="6.25" />
        <path d="M5.75 5.75l4.5 4.5M10.25 5.75l-4.5 4.5" />
      </svg>
    )
  }

  <strong class="block flex-1 leading-tight font-semibold">
    <span class="sr-only">{variant}: </span>
    {message}
  </strong>
</div>
