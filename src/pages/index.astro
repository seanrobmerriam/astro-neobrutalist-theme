  <script>
    // Demo-only handlers for the four showcase forms. The forms have nowhere
    // real to submit, so each one fires a toast that matches its context.
    function wireForm(id: string, toast: { title: string; description: string; variant: "success" | "default" }) {
      document.getElementById(id)?.addEventListener("submit", (event) => {
        event.preventDefault();
        window.showToast?.(toast);
      });
    }
    wireForm("signup-form", {
      title: "Account created",
      description: "Check your inbox to confirm your email.",
      variant: "success",
    });
    wireForm("login-form", {
      title: "Welcome back, Ava",
      description: "Signing you in…",
      variant: "default",
    });
    wireForm("contact-form", {
      title: "Message sent",
      description: "We'll reply within 1 business day.",
      variant: "success",
    });
    wireForm("profile-form", {
      title: "Profile saved",
      description: "Your changes are live.",
      variant: "success",
    });

    // Bio character counter — only one element, no need for a shared script.
    const bio = document.getElementById("profile-bio") as HTMLTextAreaElement | null;
    const counter = document.querySelector("[data-bio-count]");
    if (bio && counter) {
      const max = 280;
      const update = () => {
        counter.textContent = `${bio.value.length} / ${max}`;
      };
      bio.addEventListener("input", update);
      update();
    }

    // Filterable table: live-filter rows by the search input. The data-search
    // attribute on each row holds a lowercased haystack of every searchable
    // field, so the filter is just an indexOf check — no JSON parsing.
    const filterInput = document.getElementById("filter-rows") as HTMLInputElement | null;
    const filterTable = document.querySelector<HTMLElement>("[data-filterable-table]");
    const filterCount = document.querySelector<HTMLElement>("[data-filter-count]");
    const filterEmpty = document.querySelector<HTMLElement>("[data-filter-empty]");
    if (filterInput && filterTable && filterCount && filterEmpty) {
      const rows = Array.from(filterTable.querySelectorAll<HTMLElement>("[data-filter-row]"));
      const apply = () => {
        const q = filterInput.value.trim().toLowerCase();
        let visible = 0;
        rows.forEach((row) => {
          const hay = row.dataset.search ?? "";
          const match = q === "" || hay.includes(q);
          row.hidden = !match;
          if (match) visible++;
        });
        filterCount.textContent = String(visible);
        filterEmpty.hidden = visible !== 0;
      };
      filterInput.addEventListener("input", apply);
      apply();
    }

    // Agent chat: deterministic hash of the input picks which canned reply
    // to fetch from /api/chat/N. Same input → same reply, different inputs
    // spread across the catalogue. The endpoint is prerendered, so each
    // reply is a static file.
    const agentForm = document.querySelector<HTMLFormElement>("[data-agent-form]");
    const agentThread = document.querySelector<HTMLElement>("[data-agent-thread]");
    if (agentForm && agentThread) {
      const REPLY_COUNT = 6;
      const hash = (s: string) => {
        let h = 0;
        for (let i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) | 0;
        return Math.abs(h);
      };
      const escape = (s: string) =>
        s
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;")
          .replace(/'/g, "&#39;");

      agentForm.addEventListener("submit", async (event) => {
        event.preventDefault();
        const input = agentForm.querySelector<HTMLTextAreaElement>("textarea[name='message']");
        const text = (input?.value ?? "").trim();
        if (!text) return;

        agentForm.querySelector("[data-agent-empty]")?.setAttribute("hidden", "");

        // Echo the user message first so the round-trip feels instant.
        const userBubble = document.createElement("article");
        userBubble.className = "flex items-start gap-3 justify-end";
        userBubble.innerHTML = `<div class="min-w-0 flex-1 text-right">
          <p class="text-xs text-ink/50"><span class="mr-1">just now</span> You</p>
          <p class="mt-1 inline-block max-w-prose border-2 border-ink bg-yellow/40 px-3 py-2 text-sm text-left">${escape(text)}</p>
        </div>
        <div class="flex size-8 shrink-0 items-center justify-center border-2 border-ink bg-yellow font-mono text-xs font-bold shadow-brutal-sm">YOU</div>`;
        agentThread.appendChild(userBubble);

        const idx = hash(text) % REPLY_COUNT;
        const reply = await fetch(`/api/chat/${idx}`).then((r) => r.text());
        agentThread.querySelector("[data-typing]")?.remove();
        agentThread.insertAdjacentHTML("beforeend", reply);
        agentThread.scrollTop = agentThread.scrollHeight;
        agentForm.reset();
      });
    }
  </script>

