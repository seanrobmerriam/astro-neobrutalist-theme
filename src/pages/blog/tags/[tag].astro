---
import LandingLayout from "../../../layouts/LandingLayout.astro";
import CardStacked from "../../../components/Card/CardStacked.astro";
import { site } from "../../../config/site";
import { getPublishedPosts } from "../../../lib/blog";
import { formatDate } from "../../../lib/format-date";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];

  return tags.map((tag) => ({
    params: { tag },
    props: { posts: posts.filter((post) => post.data.tags.includes(tag)) },
  }));
}

const { tag } = Astro.params;
const { posts } = Astro.props;

const footerGroups = [
  {
    heading: "Product",
    links: [
      { label: "Landing", href: "/landing" },
      { label: "Pricing", href: "/pricing" },
      { label: "Portfolio", href: "/portfolio" },
    ],
  },
  site.footerResources,
];
---

<LandingLayout
  title={`"${tag}" posts — ${site.name} Blog`}
  description={`Posts tagged "${tag}" on the ${site.name} blog.`}
  navLinks={site.nav}
  footerGroups={footerGroups}
>
  <div class="mx-auto max-w-4xl px-6 py-20">
    <div class="mb-14 text-center">
      <span
        class="inline-block border-2 border-ink-on-accent bg-lavender px-3 py-1 font-mono text-xs font-bold text-ink-on-accent uppercase tracking-wide shadow-brutal-sm"
      >
        Tag
      </span>
      <h1 class="mt-4 text-balance font-display text-section-lg font-extrabold uppercase">{tag}</h1>
      <p class="mx-auto mt-4 max-w-xl text-pretty text-ink/70">
        {posts.length} post{posts.length === 1 ? "" : "s"} tagged "{tag}".
      </p>
    </div>

    <h2 class="sr-only">Posts tagged {tag}</h2>
    <div class="grid gap-6 sm:grid-cols-2">
      {
        posts.map((post) => (
          <CardStacked
            href={`/blog/${post.id}`}
            date={post.data.publishDate.toISOString()}
            dateLabel={formatDate(post.data.publishDate)}
            title={post.data.title}
            description={post.data.description}
          />
        ))
      }
    </div>

    <div class="mt-10 text-center">
      <a href="/blog" class="font-mono text-xs font-bold tracking-wide text-ink/60 uppercase hover:text-ink">
        ← Back to all posts
      </a>
    </div>
  </div>
</LandingLayout>
