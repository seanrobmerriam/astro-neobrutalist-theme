---
type Size = "sm" | "md" | "lg" | "xl";
type Shape = "square" | "circle";
type Accent = "yellow" | "pink" | "blue" | "green" | "orange" | "lavender";

interface Props {
  src?: string;
  alt?: string;
  /** Used to derive initials when no `src` is given. */
  name?: string;
  size?: Size;
  shape?: Shape;
  accent?: Accent;
  class?: string;
}

const { src, alt = "", name, size = "md", shape = "square", accent = "yellow", class: className } = Astro.props;

const sizes: Record<Size, string> = {
  sm: "size-8 text-xs",
  md: "size-12 text-base",
  lg: "size-16 text-xl",
  xl: "size-24 text-3xl",
};

// The wrapping <span> above is already fixed-size via `sizes[size]`, so this
// isn't preventing a layout shift — it's just correct <img> hygiene (and
// lets decoding start with known dimensions).
const pixelSizes: Record<Size, number> = { sm: 32, md: 48, lg: 64, xl: 96 };

const accents: Record<Accent, string> = {
  yellow: "bg-yellow",
  pink: "bg-pink",
  blue: "bg-blue",
  green: "bg-green",
  orange: "bg-orange",
  lavender: "bg-lavender",
};

const trimmedName = name?.trim();
const initials = trimmedName
  ? trimmedName.includes(" ")
    ? trimmedName
        .split(/\s+/)
        .slice(0, 2)
        .map((part) => part[0]?.toUpperCase())
        .join("")
    : trimmedName.slice(0, 3).toUpperCase()
  : undefined;
---

<span
  class:list={[
    "inline-flex shrink-0 items-center justify-center overflow-hidden font-heading font-bold",
    shape === "circle" ? "rounded-full" : "",
    sizes[size],
    // A real image sits on bg-paper, which inverts correctly with the
    // theme; the initials fallback sits on a fixed categorical accent, so
    // it needs the fixed border/text pairing instead (see global.css).
    src
      ? "border-2 border-ink bg-paper text-ink"
      : ["border-2 border-ink-on-accent text-ink-on-accent", accents[accent]],
    className,
  ]}
>
  {
    src ? (
      <img
        src={src}
        alt={alt}
        width={pixelSizes[size]}
        height={pixelSizes[size]}
        class="size-full object-cover"
        loading="lazy"
        decoding="async"
      />
    ) : (
      <span aria-hidden={alt ? undefined : "true"}>{initials ?? "?"}</span>
    )
  }
</span>
