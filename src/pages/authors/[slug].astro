---
import { getCollection } from "astro:content";
import LandingLayout from "../../layouts/LandingLayout.astro";
import Avatar from "../../components/Avatar/Avatar.astro";
import CardStacked from "../../components/Card/CardStacked.astro";
import { site } from "../../config/site";
import { getPublishedPosts } from "../../lib/blog";
import { formatDate } from "../../lib/format-date";

export async function getStaticPaths() {
  const authors = await getCollection("authors");
  const posts = await getPublishedPosts();

  return authors.map((author) => ({
    params: { slug: author.id },
    props: { author, posts: posts.filter((post) => post.data.author.id === author.id) },
  }));
}

const { author, posts } = Astro.props;

const footerGroups = [
  {
    heading: "Product",
    links: [
      { label: "Landing", href: "/landing" },
      { label: "Pricing", href: "/pricing" },
      { label: "Portfolio", href: "/portfolio" },
    ],
  },
  site.footerResources,
];
---

<LandingLayout
  title={`${author.data.name} — ${site.name} Blog`}
  description={author.data.bio}
  navLinks={site.nav}
  navCtaLabel="Get Theme"
  navCtaHref="/pricing"
  footerGroups={footerGroups}
>
  <div class="mx-auto max-w-4xl px-6 py-20">
    <div class="mb-14 flex flex-col items-center text-center">
      <Avatar name={author.data.name} size="xl" accent="blue" />
      <h1 class="mt-4 text-balance font-display text-4xl font-extrabold uppercase sm:text-5xl">{author.data.name}</h1>
      <p class="mt-1 font-mono text-xs font-bold tracking-wide text-ink/60 uppercase">{author.data.role}</p>
      <p class="mx-auto mt-4 max-w-xl text-pretty text-ink/70">{author.data.bio}</p>
    </div>

    <h2 class="sr-only">Posts by {author.data.name}</h2>
    {
      posts.length > 0 ? (
        <div class="grid gap-6 sm:grid-cols-2">
          {posts.map((post) => (
            <CardStacked
              href={`/blog/${post.id}`}
              date={post.data.publishDate.toISOString()}
              dateLabel={formatDate(post.data.publishDate)}
              title={post.data.title}
              description={post.data.description}
            />
          ))}
        </div>
      ) : (
        <p class="text-center text-ink/60">No published posts yet.</p>
      )
    }

    <div class="mt-10 text-center">
      <a href="/blog" class="font-mono text-xs font-bold tracking-wide text-ink/60 uppercase hover:text-ink">
        ← Back to all posts
      </a>
    </div>
  </div>
</LandingLayout>
