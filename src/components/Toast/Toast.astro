---
import Icon from "../Icon/Icon.astro";

type Variant = "default" | "success" | "error" | "warning";

interface Props {
  variant?: Variant;
  title: string;
  description?: string;
  class?: string;
}

const { variant = "default", title, description, class: className } = Astro.props;

// "default" (bg-paper) inverts correctly with the theme; the three real
// accent fills don't, so they need the fixed border-ink-on-accent/
// text-ink-on-accent (see global.css / Button.astro for the full reasoning).
const surface: Record<Variant, string> = {
  default: "border-ink bg-paper text-ink",
  success: "border-ink-on-accent bg-green text-ink-on-accent",
  error: "border-ink-on-accent bg-pink text-ink-on-accent",
  warning: "border-ink-on-accent bg-orange text-ink-on-accent",
};
const mutedText: Record<Variant, string> = {
  default: "text-ink/80",
  success: "text-ink-on-accent/80",
  error: "text-ink-on-accent/80",
  warning: "text-ink-on-accent/80",
};
---

<div
  role="status"
  class:list={[
    "flex w-full max-w-sm items-start gap-3 border-[3px] p-4 shadow-brutal-invert-lg",
    surface[variant],
    className,
  ]}
>
  <div class="min-w-0 flex-1">
    <p class="font-heading font-bold">{title}</p>
    {description && <p class:list={["mt-1 text-sm", mutedText[variant]]}>{description}</p>}
  </div>
  <button
    type="button"
    aria-label="Dismiss notification"
    class="flex size-6 shrink-0 items-center justify-center border-2 border-ink bg-paper font-bold hover:bg-pink"
  >
    <Icon name="close" class="size-3" />
  </button>
</div>
