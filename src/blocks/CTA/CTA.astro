---
import Button from "../../components/Button/Button.astro";
import Container from "../../components/Container/Container.astro";

type Accent = "yellow" | "pink" | "blue" | "green" | "orange" | "lavender";

interface Cta {
  label: string;
  href: string;
}

interface Props {
  id?: string;
  title: string;
  description?: string;
  primaryCta: Cta;
  secondaryCta?: Cta;
  accent?: Accent;
  class?: string;
}

const { id, title, description, primaryCta, secondaryCta, accent = "yellow", class: className } = Astro.props;

const accents: Record<Accent, string> = {
  yellow: "bg-yellow",
  pink: "bg-pink",
  blue: "bg-blue",
  green: "bg-green",
  orange: "bg-orange",
  lavender: "bg-lavender",
};
---

<Container as="section" id={id} class="py-10">
  <div
    class:list={[
      "flex flex-col items-center gap-6 border-[3px] border-ink-on-accent px-8 py-14 text-center text-ink-on-accent shadow-brutal-lg sm:flex-row sm:justify-between sm:text-left",
      accents[accent],
      className,
    ]}
  >
    <div>
      <h2 class="text-balance font-display text-section-sm font-extrabold uppercase">{title}</h2>
      {description && <p class="mt-3 max-w-md text-pretty text-ink-on-accent/80">{description}</p>}
    </div>

    <div class="flex shrink-0 flex-wrap items-center justify-center gap-3">
      <Button href={primaryCta.href} variant="outline">
        {primaryCta.label}
      </Button>
      {
        // variant="ghost" defaults to text-ink, which correctly inverts on
        // the plain page background it usually sits on — but this button
        // sits on the CTA's own accent fill, which doesn't invert. `!` wins
        // regardless of Tailwind's generated class order (the same hazard
        // documented in Button.astro / global.css for border-ink-on-accent),
        // not just append-order in this class list.
        secondaryCta && (
          <Button href={secondaryCta.href} variant="ghost" class="!text-ink-on-accent">
            {secondaryCta.label}
          </Button>
        )
      }
    </div>
  </div>
</Container>
