---
import "../styles/global.css";
import { Font } from "astro:assets";
import SEO from "../components/SEO/SEO.astro";
import { site } from "../config/site";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title = `${site.name} — An Astro + Tailwind Theme`,
  description = site.description,
  image,
  noindex,
} = Astro.props;
---

<!doctype html>
<html lang={site.locale} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Blocking and inline on purpose: applies a stored theme choice before
      // first paint. Deferred or module scripts run too late here and cause
      // a visible flash of the wrong theme. The page defaults to light
      // (data-theme="light" on <html>); this only overrides it when the
      // visitor has explicitly picked dark.
      try {
        var theme = localStorage.getItem("theme");
        if (theme === "dark") {
          document.documentElement.setAttribute("data-theme", "dark");
        }
      } catch (e) {}
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <SEO title={title} description={description} image={image} noindex={noindex} />

    <Font cssVariable="--font-clariza-sparks" preload />
    <Font cssVariable="--font-eustace" preload />
    <Font cssVariable="--font-devina-rodent" preload={[{ weight: "400", style: "normal" }]} />
    <Font cssVariable="--font-alma-mono" />
  </head>
  <body class="bg-paper font-sans text-ink antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:border-2 focus:border-ink focus:bg-yellow focus:px-4 focus:py-2 focus:font-heading focus:font-bold focus:shadow-brutal-sm"
    >
      Skip to main content
    </a>
    <slot />
  </body>
</html>
