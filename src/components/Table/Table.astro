---
type Tone = "yellow" | "pink" | "blue" | "green" | "orange" | "lavender";
type CellValue = string | { text: string; tone: Tone };

interface Column {
  key: string;
  label: string;
}

interface Props {
  columns: Column[];
  rows: Record<string, CellValue>[];
  caption?: string;
  class?: string;
}

const { columns, rows, caption, class: className } = Astro.props;

const tones: Record<Tone, string> = {
  yellow: "bg-yellow",
  pink: "bg-pink",
  blue: "bg-blue",
  green: "bg-green",
  orange: "bg-orange",
  lavender: "bg-lavender",
};

const zebraTones = ["bg-yellow/10", "bg-blue/10", "bg-lavender/10"];

function isToned(value: CellValue): value is { text: string; tone: Tone } {
  return typeof value === "object";
}
---

<div class:list={["overflow-x-auto border-[3px] border-ink shadow-brutal", className]}>
  <table class="w-full border-collapse text-left">
    {caption && <caption class="border-b-[3px] border-ink bg-paper px-4 py-3 text-left font-heading font-bold">{caption}</caption>}
    <thead>
      <tr class="bg-ink text-paper">
        {
          columns.map((column) => (
            <th scope="col" class="whitespace-nowrap px-4 py-3 font-mono text-xs font-bold uppercase tracking-wide">
              {column.label}
            </th>
          ))
        }
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row, i) => (
          <tr class:list={["border-t-2 border-ink", i % 2 === 1 && zebraTones[i % zebraTones.length]]}>
            {columns.map((column) => {
              const value = row[column.key];
              return (
                <td class="whitespace-nowrap px-4 py-3">
                  {isToned(value) ? (
                    <span class:list={["inline-block border-2 border-ink px-2 py-0.5 text-xs font-bold uppercase", tones[value.tone]]}>
                      {value.text}
                    </span>
                  ) : (
                    value
                  )}
                </td>
              );
            })}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
