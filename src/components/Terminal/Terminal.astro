---
import { Code } from "astro:components";
import { neubrutalTheme } from "../../lib/shiki-theme";

interface Props {
  filename?: string;
  code: string;
  lang?: "astro" | "typescript" | "javascript" | "css" | "bash";
  class?: string;
}

const { filename, code, lang = "astro", class: className } = Astro.props;
---

<div class:list={["overflow-hidden border-[3px] border-ink bg-ink text-paper shadow-brutal-lg", className]}>
  <div class="flex items-center gap-2 border-b-[3px] border-ink bg-paper px-4 py-3">
    <span class="size-3 rounded-full border-2 border-ink bg-pink" aria-hidden="true"></span>
    <span class="size-3 rounded-full border-2 border-ink bg-yellow" aria-hidden="true"></span>
    <span class="size-3 rounded-full border-2 border-ink bg-green" aria-hidden="true"></span>
    {filename && <span class="ml-2 font-mono text-xs font-bold text-ink">{filename}</span>}
  </div>

  <div class="max-h-80 overflow-auto [&_pre]:p-4! [&_pre]:text-xs [&_pre]:leading-relaxed sm:[&_pre]:text-sm">
    <Code code={code} lang={lang} theme={neubrutalTheme} />
  </div>
</div>
