---
import { getCollection } from "astro:content";
import LandingLayout from "../layouts/LandingLayout.astro";
import Card from "../components/Card/Card.astro";
import CTA from "../blocks/CTA/CTA.astro";
import { site } from "../config/site";

const footerGroups = [
  {
    heading: "Product",
    links: [
      { label: "Landing", href: "/landing" },
      { label: "Pricing", href: "/pricing" },
      { label: "Blog", href: "/blog" },
    ],
  },
  site.footerResources,
];

const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
---

<LandingLayout
  title={`Portfolio — ${site.name}`}
  description={`Selected work built with the ${site.name} theme.`}
  navLinks={site.nav}
  footerGroups={footerGroups}
>
  <div class="mx-auto max-w-5xl px-6 py-20">
    <div class="mb-14 text-center">
      <span
        class="inline-block border-2 border-ink-on-accent bg-blue px-3 py-1 font-mono text-xs font-bold text-ink-on-accent uppercase tracking-wide shadow-brutal-sm"
      >
        Portfolio
      </span>
      <h1 class="mt-4 text-balance font-display text-section-lg font-extrabold uppercase">Selected work</h1>
      <p class="mx-auto mt-4 max-w-xl text-pretty text-ink/70">
        A handful of projects, all built on the same bold, flat-color system.
      </p>
    </div>

    <h2 class="sr-only">Projects</h2>
    {
      projects.length > 0 ? (
        <div class="grid gap-6 sm:grid-cols-2">
          {projects.map((project) => (
            <Card
              interactive={false}
              eyebrow={project.data.eyebrow}
              title={project.data.title}
              description={project.data.description}
              accent={project.data.accent}
            />
          ))}
        </div>
      ) : (
        <p class="text-center text-ink/60">No projects yet — check back soon.</p>
      )
    }
  </div>

  <CTA
    id="cta"
    title="Like what you see?"
    description="This whole site — landing page included — is built from the same theme."
    primaryCta={{ label: "Get Theme", href: "/pricing" }}
    secondaryCta={{ label: "Read Docs", href: "/docs" }}
    accent="green"
  />
</LandingLayout>
