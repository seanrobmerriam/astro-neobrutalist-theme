---
interface Props {
  date: string;
  dateLabel: string;
  title: string;
  description: string;
  href?: string;
  class?: string;
}

const { date, dateLabel, title, description, href = "#", class: className } = Astro.props;
---

<a
  href={href}
  class:list={[
    "block border-[3px] border-ink bg-paper p-4 text-ink shadow-brutal-lg transition-all duration-150 hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-brutal-xl sm:p-6",
    className,
  ]}
>
  <span class="inline-flex items-center gap-1.5 font-mono text-xs font-bold tracking-wide text-ink/60 uppercase">
    <svg aria-hidden="true" viewBox="0 0 16 16" fill="currentColor" class="size-4">
      <path
        fill-rule="evenodd"
        d="M4 1.75a.75.75 0 0 1 1.5 0V3h5V1.75a.75.75 0 0 1 1.5 0V3a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2V1.75ZM4.5 6a1 1 0 0 0-1 1v4.5a1 1 0 0 0 1 1h7a1 1 0 0 0 1-1V7a1 1 0 0 0-1-1h-7Z"
        clip-rule="evenodd"
      />
    </svg>
    <time datetime={date}>{dateLabel}</time>
  </span>

  <h3 class="mt-2 font-heading text-xl font-bold">{title}</h3>
  <p class="mt-2 line-clamp-2 text-pretty text-ink/70">{description}</p>
</a>
