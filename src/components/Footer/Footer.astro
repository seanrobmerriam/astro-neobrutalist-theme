---
interface LinkGroup {
  heading: string;
  links: { label: string; href: string }[];
}

interface Props {
  brand?: string;
  tagline?: string;
  groups?: LinkGroup[];
  class?: string;
}

const {
  brand = "Neubrutal",
  tagline = "An Astro + Tailwind theme, built loud on purpose.",
  groups = [],
  class: className,
} = Astro.props;

const year = new Date().getFullYear();
---

<footer class:list={["border-t-[3px] border-ink bg-paper", className]}>
  <div class="mx-auto max-w-6xl px-6 py-16">
    <div class="grid gap-12 md:grid-cols-[1.5fr_repeat(3,1fr)]">
      <div>
        <p class="font-display text-2xl font-extrabold uppercase">{brand}</p>
        <p class="mt-3 max-w-xs text-ink/70">{tagline}</p>
        <div class="mt-6 flex gap-3">
          <slot name="social" />
        </div>
      </div>

      {
        groups.map((group) => (
          <div>
            <p class="font-mono text-xs font-bold uppercase tracking-wide text-ink/60">{group.heading}</p>
            <ul class="mt-4 flex flex-col gap-2.5">
              {group.links.map((link) => (
                <li>
                  <a href={link.href} class="font-medium text-ink hover:underline hover:decoration-2 hover:underline-offset-4">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="mt-16 flex flex-col gap-4 border-t-2 border-ink pt-6 sm:flex-row sm:items-center sm:justify-between">
      <p class="font-mono text-xs text-ink/60">© {year} {brand}. All rights reserved.</p>
      <slot />
    </div>
  </div>
</footer>
