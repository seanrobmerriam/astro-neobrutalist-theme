---
import { getCollection } from "astro:content";
import Layout from "./Layout.astro";
import Navbar from "../blocks/Navbar/Navbar.astro";
import Footer from "../components/Footer/Footer.astro";
import Drawer from "../components/Drawer/Drawer.astro";
import Icon from "../components/Icon/Icon.astro";
import { site } from "../config/site";

interface Props {
  title?: string;
  description?: string;
  /** The current entry's id, to highlight it in the sidebar nav. */
  currentSlug?: string;
}

const { title, description, currentSlug } = Astro.props;

const entries = (await getCollection("docs")).sort((a, b) => a.data.order - b.data.order);

const navLinkClass = (active: boolean) =>
  [
    "block border-2 px-3 py-2 font-heading text-sm font-semibold",
    active ? "border-ink bg-yellow text-ink" : "border-transparent text-ink hover:bg-ink hover:text-paper",
  ].join(" ");
---

<Layout
  title={title ? `${title} — ${site.name} Docs` : `${site.name} Docs`}
  description={description ?? site.description}
>
  <Navbar
    brand={site.name}
    links={[
      { label: "Home", href: "/" },
      { label: "Docs", href: "/docs" },
    ]}
    ctaLabel="View theme"
    ctaHref="/"
  />

  <div class="mx-auto max-w-6xl px-6 py-10 lg:flex lg:items-start lg:gap-10">
    <button
      type="button"
      data-dialog-open="docs-nav"
      class="mb-6 flex w-full items-center justify-between border-2 border-ink bg-paper px-4 py-3 font-heading font-bold shadow-brutal-sm lg:hidden"
    >
      Documentation menu
      <Icon name="menu" class="size-4" />
    </button>

    <aside class="hidden shrink-0 lg:block lg:w-56">
      <nav class="sticky top-24 flex flex-col gap-1" aria-label="Documentation">
        {
          entries.map((entry) => (
            <a href={`/docs/${entry.id}`} class={navLinkClass(entry.id === currentSlug)}>
              {entry.data.title}
            </a>
          ))
        }
      </nav>
    </aside>

    <main id="main" class="prose min-w-0 flex-1" data-pagefind-body>
      <slot />
    </main>
  </div>

  <Drawer id="docs-nav" title="Documentation" side="left">
    <nav class="flex flex-col gap-1" aria-label="Documentation">
      {
        entries.map((entry) => (
          <a href={`/docs/${entry.id}`} data-dialog-close class={navLinkClass(entry.id === currentSlug)}>
            {entry.data.title}
          </a>
        ))
      }
    </nav>
  </Drawer>

  <Footer brand={site.name} tagline={site.tagline}>
    <div class="flex gap-4 font-mono text-xs text-ink/60">
      <a href="/privacy" class="hover:underline hover:decoration-2 hover:underline-offset-4">Privacy</a>
      <a href="/terms" class="hover:underline hover:decoration-2 hover:underline-offset-4">Terms</a>
    </div>
  </Footer>
</Layout>
